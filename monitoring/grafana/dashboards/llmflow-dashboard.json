{
    "dashboard": {
        "id": null,
        "uid": "llmflow-overview",
        "title": "LLMFlow - System Overview",
        "tags": [
            "llmflow"
        ],
        "timezone": "browser",
        "schemaVersion": 39,
        "refresh": "5s",
        "time": {
            "from": "now-15m",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "Requests per Second",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 0,
                    "y": 0
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "sum(rate(llm_requests_total[1m]))",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "reqps",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "color": "green",
                                    "value": null
                                },
                                {
                                    "color": "yellow",
                                    "value": 5
                                },
                                {
                                    "color": "red",
                                    "value": 10
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 2,
                "title": "Active Requests",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 6,
                    "y": 0
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "llm_active_requests",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "color": "green",
                                    "value": null
                                },
                                {
                                    "color": "yellow",
                                    "value": 10
                                },
                                {
                                    "color": "red",
                                    "value": 50
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 3,
                "title": "Total Requests",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 12,
                    "y": 0
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "sum(llm_requests_total)",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "color": "blue",
                                    "value": null
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 4,
                "title": "Total Tokens Used",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 18,
                    "y": 0
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "sum(llm_tokens_used_total)",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "color": "purple",
                                    "value": null
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 5,
                "title": "Request Rate Over Time",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 6
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "rate(llm_requests_total[1m])",
                        "legendFormat": "{{provider}} - {{status}}",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "custom": {
                            "fillOpacity": 20,
                            "lineWidth": 2
                        }
                    }
                }
            },
            {
                "id": 6,
                "title": "Latency Percentiles",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 6
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p50",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p95",
                        "refId": "B"
                    },
                    {
                        "expr": "histogram_quantile(0.99, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p99",
                        "refId": "C"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "s",
                        "custom": {
                            "fillOpacity": 10,
                            "lineWidth": 2
                        }
                    }
                }
            },
            {
                "id": 7,
                "title": "Cache Performance",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 14
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "rate(llm_cache_hits_total[1m])",
                        "legendFormat": "Hits",
                        "refId": "A"
                    },
                    {
                        "expr": "rate(llm_cache_misses_total[1m])",
                        "legendFormat": "Misses",
                        "refId": "B"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "custom": {
                            "fillOpacity": 30,
                            "lineWidth": 2,
                            "stacking": {
                                "mode": "normal"
                            }
                        }
                    }
                }
            },
            {
                "id": 8,
                "title": "Token Usage by Provider",
                "type": "timeseries",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 14
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": "PBFA97CFB590B2093"
                },
                "targets": [
                    {
                        "expr": "rate(llm_tokens_used_total[1m])",
                        "legendFormat": "{{provider}}",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "short",
                        "custom": {
                            "fillOpacity": 20,
                            "lineWidth": 2
                        }
                    }
                }
            }
        ]
    },
    "overwrite": true
}